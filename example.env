# Supabase Configuration
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-actual-anon-key-here

# Google Gemini AI — used CLIENT-SIDE (visible in browser DevTools)
# Get this from: https://aistudio.google.com/app/apikey
# For production, proxy calls through a backend/edge function to keep this secret.
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Optional: webhook URL for production error logging (e.g., Supabase Edge Function or Sentry relay)
# If not set, errors are logged to console only.
VITE_LOG_WEBHOOK_URL=
